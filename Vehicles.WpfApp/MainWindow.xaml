<Window x:Class="Vehicles.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vehicles"
        Height="500"
        Width="700">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Vehicle name:"/>

        <TextBox Grid.Row="1"
                 x:Name="NameTextBox"
                 Height="30"
                 Margin="0,3,0,10"/>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Vehicle type:"/>

            <ComboBox x:Name="TypeComboBox"
                      Height="30"
                      Margin="0,3,0,10"
                      SelectedIndex="0">

                <ComboBoxItem Content="Car"/>
                <ComboBoxItem Content="Boat"/>
                <ComboBoxItem Content="AmphibiousCar"/>

            </ComboBox>

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,10">

                <Button Content="Add vehicle"
                        Width="120"
                        Height="35"
                        Margin="0,0,10,0"
                        Click="AddVehicle_Click"/>

                <Button Content="Move 10 km"
                        Width="120"
                        Height="35"
                        Click="MoveVehicle_Click"/>

            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="3"
                   Text="Vehicles:"
                   FontWeight="Bold"/>

        <ListBox Grid.Row="4"
                 x:Name="VehicleListBox"
                 Margin="0,3,0,10"/>

        <TextBlock Grid.Row="5"
                   Text="Log:"
                   FontWeight="Bold"/>

        <TextBox Grid.Row="6"
                 x:Name="LogTextBox"
                 Margin="0,3,0,0"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"/>

    </Grid>
</Window>